# Local configuration is added by the package that owns it. Do not commit secrets.
# Strict production renderer gate (no floating tags; values intentionally unset until CP-2 approval)
RJLS_RENDER_PROFILE=production-oci
RJLS_RENDER_ENGINE=
RJLS_RENDER_MODE=
RJLS_OPENSCAD_IMAGE=
RJLS_OPENSCAD_VERSION=
RJLS_OPENSCAD_BINARY_SHA256=
RJLS_OPENSCAD_HELP_SHA256=
RJLS_BOSL2_PATH=
RJLS_BOSL2_VERSION=
RJLS_BOSL2_SHA256=
RJLS_PROJECTS_ROOT=.rjls-projects
RJLS_ALLOWED_ORIGIN=http://localhost:3000
RJLS_CHAT_PROVIDER=mock

# Explicit development-only alternative: trusted-local-development runs the host OpenSCAD binary
# without isolation, emits a warning on every job, and its provenance cannot be promoted.
# RJLS_RENDER_PROFILE=trusted-local-development
# RJLS_LOCAL_OPENSCAD_EXECUTABLE=/absolute/path/to/openscad
