# Local configuration is added by the package that owns it. Do not commit secrets.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rjls
RJLS_DATABASE_POOL_MAX=5
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
RJLS_ALLOWED_ORIGIN=http://localhost:3000
RJLS_CHAT_PROVIDER=mock

# Remote HTTP MCP and browser OAuth; apply migrations and provision a client first.
RJLS_REMOTE_MCP_ENABLED=0

# Development-only bridge that lets a standalone Codex MCP process ask the open
# browser tab to validate candidates with the pinned OpenSCAD WASM renderer.
# It is always disabled when NODE_ENV=production.
RJLS_LOCAL_MCP_BRIDGE=1

# Required only by the trusted standalone stdio MCP process. Set it to an ID
# from the Better Auth user table; browser requests derive this from the session.
RJLS_ACTOR_USER_ID=
