# Local configuration is added by the package that owns it. Do not commit secrets.
# Docker host port. If changed, use the same port in DATABASE_URL below.
THEORYFOUNDRY_POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/theoryfoundry
THEORYFOUNDRY_DATABASE_POOL_MAX=5
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
THEORYFOUNDRY_ALLOWED_ORIGIN=http://localhost:3000
THEORYFOUNDRY_CHAT_PROVIDER=mock

# Remote HTTP MCP and browser OAuth; apply migrations and provision a client first.
THEORYFOUNDRY_REMOTE_MCP_ENABLED=0

# Development-only bridge that lets a standalone Codex MCP process ask the open
# browser tab to validate candidates with the pinned OpenSCAD WASM renderer.
# It is always disabled when NODE_ENV=production.
THEORYFOUNDRY_LOCAL_MCP_BRIDGE=1

# Required only by the trusted standalone stdio MCP process. Set it to an ID
# from the Better Auth user table; browser requests derive this from the session.
THEORYFOUNDRY_ACTOR_USER_ID=

# Private temporary export directory; use the same absolute path for site and MCP.
# THEORYFOUNDRY_EXPORT_DIRECTORY=/absolute/private/cad-exports

# Server-only Unleash Frontend API configuration. Use a frontend token scoped to
# the default project and desired environment; never use an admin token.
# Both unset defaults to sidebar hidden / mock mode.
UNLEASH_FRONTEND_API_URL=
UNLEASH_FRONTEND_API_TOKEN=
