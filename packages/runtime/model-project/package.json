{
  "name": "@theoryfoundry/model-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node ../../../tooling/testing/runTests.script.mjs --project"
  },
  "dependencies": {
    "@theoryfoundry/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "pg-mem": "^3.0.14",
    "rimraf": "^6.0.1"
  }
}
